@inherits Modal<ReportDetailsModal.ModalParams>
@inject StaffService StaffService
@inject ValourClient Client
@inject IStringLocalizer<ReportDetailsModal> Localizer
@inject IStringLocalizer<ReportsQueryTable> RQTLocalizer
@inject IStringLocalizer<ValourApp> CommonLocalizer

<BasicModalLayout Title="@Localizer["Report Details"]" Icon="flag-fill" MaxWidth="700px">
    <MainArea>
        <div class="report-details">
            <div class="report-section">
                <h4>@Localizer["Report Information"]</h4>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="label">@Localizer["Report ID"]</span>
                        <span class="value mono">@Data.Report.Id</span>
                    </div>
                    <div class="info-item">
                        <span class="label">@Localizer["Created"]</span>
                        <span class="value mono">@Data.Report.TimeCreated.ToString("g")</span>
                    </div>
                    <div class="info-item">
                        <span class="label">@RQTLocalizer["Reason"]</span>
                        <span class="value reason-badge @GetReasonClass()">@RQTLocalizer[GetReasonTitle()]</span>
                    </div>
                    <div class="info-item">
                        <span class="label">@RQTLocalizer["Status"]</span>
                        <span class="value status-badge @GetStatusClass()">@RQTLocalizer[GetStatusText()]</span>
                    </div>
                </div>
            </div>

            <div class="report-section">
                <h4>@Localizer["Users"]</h4>
                <div class="users-grid">
                    <div class="user-item">
                        <span class="label">@RQTLocalizer["Reporter"]</span>
                        <UserInfoMini UserId="@Data.Report.ReportingUserId" />
                    </div>
                    <div class="user-item">
                        <span class="label">@RQTLocalizer["Reported User"]</span>
                        @if (Data.Report.ReportedUserId.HasValue)
                        {
                            <UserInfoMini UserId="@Data.Report.ReportedUserId" />
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Data.Report.LongReason))
            {
                <div class="report-section">
                    <h4>@RQTLocalizer["Description"]</h4>
                    <div class="description-box">
                        @Data.Report.LongReason
                    </div>
                </div>
            }

            @if (Data.Report.ThreadId.HasValue)
            {
                <div class="report-section">
                    <h4>@(Data.Report.ThreadCommentId.HasValue ? Localizer["Reported Thread Comment"] : Localizer["Reported Thread"])</h4>
                    @if (_isLoadingThread)
                    {
                        <div class="message-loading">@Localizer["Loading thread content..."]</div>
                    }
                    else if (Data.Report.ThreadCommentId.HasValue && _reportedComment is not null)
                    {
                        <div class="reported-message-container">
                            @if (_reportedComment.IsDeleted)
                            {
                                <p><i>@Localizer["This comment was deleted."]</i></p>
                            }
                            else
                            {
                                <RichText Content="@_reportedComment.Content" PlanetId="@_reportedComment.PlanetId"/>
                            }
                        </div>
                    }
                    else if (!Data.Report.ThreadCommentId.HasValue && _reportedThread is not null)
                    {
                        <div class="reported-message-container">
                            <Valour.Client.Components.Windows.ThreadWindows.ThreadCard Thread="@_reportedThread" Preview="true" Clickable="false" ShowPlanet="true"/>
                        </div>
                    }
                    else
                    {
                        <div class="message-error">
                            <span>@Localizer["Thread content could not be loaded (ID: <span class=\"mono\">{0}</span>)", Data.Report.ThreadId]</span>
                            <button class="v-btn small secondary" @onclick="LoadThread">@CommonLocalizer["Retry"]</button>
                        </div>
                    }
                </div>
            }

            @if (Data.Report.MessageId.HasValue)
            {
                <div class="report-section">
                    <h4>@Localizer["Reported Message"]</h4>
                    @if (_isLoadingMessage)
                    {
                        <div class="message-loading">@Localizer["Loading message..."]</div>
                    }
                    else if (_reportedMessage is not null)
                    {
                        <div class="reported-message-container">
                            <MessageComponent ParamData="@_messageParams" />
                        </div>
                    }
                    else
                    {
                        <div class="message-error">
                            <span>@Localizer["Message could not be loaded (ID: <span class=\"mono\">{0}</span>))", Data.Report.MessageId]</span>
                            <button class="v-btn small secondary" @onclick="LoadMessage">@CommonLocalizer["Retry"]</button>
                        </div>
                    }
                </div>
            }

            @if (_evidence.Count > 0)
            {
                <div class="report-section">
                    <h4>Revealed by the reporter</h4>
                    <ReportEvidenceView Evidence="@_evidence" PlanetId="@Data.Report.PlanetId" />
                </div>
            }

            @if (Data.Report.Resolution != ReportResolution.None)
            {
                <div class="report-section resolved-section">
                    <h4>@Localizer["Resolution"]</h4>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="label">@Localizer["Resolution"]</span>
							<span class="value">@Localizer[GetResolutionDisplayName()]</span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["Resolved At"]</span>
                            <span class="value mono">@Data.Report.ResolvedAt?.ToString("g")</span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["Resolved By"]</span>
                            @if (Data.Report.ResolvedById.HasValue)
                            {
                                <UserInfoMini UserId="@Data.Report.ResolvedById" />
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Data.Report.StaffNotes))
                    {
                        <div class="staff-notes">
                            <span class="label">@Localizer["Staff Notes"]</span>
                            <div class="notes-box">@Data.Report.StaffNotes</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="report-section resolve-form">
                    <h4>@Localizer["Resolve Report"]</h4>
                    <div class="form-group">
                        <label>@Localizer["Resolution"]</label>
                        <select class="form-control" @bind="_selectedResolution">
                        <option value="@ReportResolution.NoAction">@Localizer["No Action Needed"]</option>
                        <option value="@ReportResolution.Warning">@Localizer["Warning Issued"]</option>
                        <option value="@ReportResolution.UserDisabled">@Localizer["User Disabled"]</option>
                        <option value="@ReportResolution.ContentRemoved">@Localizer["Content Removed"]</option>
                        <option value="@ReportResolution.UserDeleted">@Localizer["User Deleted"]</option>
                        <option value="@ReportResolution.Duplicate">@Localizer["Duplicate Report"]</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>@Localizer["Staff Notes"]</label>
                        <textarea class="form-control" @bind="_staffNotes" rows="3" placeholder="@Localizer["Add internal notes about this report..."]"></textarea>
                    </div>
                    <div class="quick-actions">
                        <h5>@Localizer["Quick Actions"]</h5>
                        <div class="action-buttons">
                            @if (Data.Report.ReportedUserId.HasValue)
                            {
                                <button class="v-btn danger" @onclick="DisableUserAndResolve">@RQTLocalizer["Disable User"]</button>
                            }
                            <button class="v-btn secondary" @onclick="() => ResolveReport(ReportResolution.NoAction)">No action</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </MainArea>
    <ButtonArea>
        <div class="basic-modal-buttons">
            <button @onclick="Close" class="v-btn">@CommonLocalizer["Close"]</button>
            @if (Data.Report.Resolution == ReportResolution.None)
            {
                <button @onclick="SubmitResolution" class="v-btn primary" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span>@Localizer["Resolving..."]</span>
                    }
                    else
                    {
                        <span>@Localizer["Resolve Report"]</span>
                    }
                </button>
            }
        </div>
    </ButtonArea>
</BasicModalLayout>

@code {
    public class ModalParams
    {
        public Report Report { get; set; }
        public Func<Task> OnResolved { get; set; }
    }

    private ReportResolution _selectedResolution = ReportResolution.NoAction;
    private string _staffNotes = "";
    private bool _isSubmitting = false;

    // Message display
    private Message _reportedMessage;
    private List<ReportEvidenceDto> _evidence = new();
    private MessageComponent.Params _messageParams;
    private bool _isLoadingMessage = false;

    private Valour.Sdk.Models.Threads.PlanetThread _reportedThread;
    private Valour.Sdk.Models.Threads.ThreadComment _reportedComment;
    private bool _isLoadingThread = false;

    protected override async Task OnInitializedAsync()
    {
        if (Data.Report.MessageId.HasValue)
        {
            await LoadMessage();
        }

        if (Data.Report.ThreadId.HasValue)
        {
            await LoadThread();
        }
    }

    private async Task LoadThread()
    {
        if (!Data.Report.ThreadId.HasValue || !Data.Report.PlanetId.HasValue)
            return;

        _isLoadingThread = true;
        StateHasChanged();

        try
        {
            if (Data.Report.ThreadCommentId.HasValue)
            {
                _reportedComment = await Client.ThreadService.FetchCommentAsync(
                    Data.Report.PlanetId.Value, Data.Report.ThreadId.Value, Data.Report.ThreadCommentId.Value, skipCache: true);
            }
            else
            {
                _reportedThread = await Client.ThreadService.FetchThreadAsync(
                    Data.Report.PlanetId.Value, Data.Report.ThreadId.Value, skipCache: true);
            }
        }
        catch (Exception e)
        {
            Console.WriteLine($"Failed to load reported thread {Data.Report.ThreadId}: {e.Message}");
        }
        finally
        {
            _isLoadingThread = false;
            StateHasChanged();
        }
    }

    private async Task LoadMessage()
    {
        if (!Data.Report.MessageId.HasValue) return;

        _isLoadingMessage = true;
        StateHasChanged();

        try
        {
            _reportedMessage = await StaffService.GetMessageAsync(Data.Report.MessageId.Value);
            _evidence = await StaffService.GetReportEvidenceAsync(Data.Report.Id);
            if (_reportedMessage is not null)
            {
                _messageParams = new MessageComponent.Params
                {
                    Message = _reportedMessage,
                    UnreadableNotice = _evidence.Count > 0
                        ? "End-to-end encrypted. Staff can't read this message; review the text the reporter revealed below."
                        : "End-to-end encrypted. Staff can't read this message, and the reporter did not reveal its text."
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load message: {ex.Message}");
            _reportedMessage = null;
        }
        finally
        {
            _isLoadingMessage = false;
            StateHasChanged();
        }
    }

    private string GetReasonTitle()
    {
        return ReportReasons.Reasons.FirstOrDefault(r => r.Code == Data.Report.ReasonCode)?.Title ?? "Unknown";
    }

    private string GetReasonClass()
    {
        return Data.Report.ReasonCode switch
        {
            ReportReasonCode.IsMinorSexualContent or
            ReportReasonCode.IsTerroristContent or
            ReportReasonCode.IsThreatsOrViolence => "severe",
            ReportReasonCode.IsPromotingIllegal or
            ReportReasonCode.IsTargetedHarassment or
            ReportReasonCode.IsNonConsensualImages or
            ReportReasonCode.IsBanEvasion => "moderate",
            _ => "minor"
        };
    }

    private string GetStatusClass()
    {
        return Data.Report.Resolution == ReportResolution.None ? "unresolved" : "resolved";
    }

    private string GetStatusText()
    {
        return Data.Report.Resolution == ReportResolution.None ? "Unresolved" : "Resolved";
    }

    private string GetResolutionDisplayName()
    {
        return Data.Report.Resolution switch
        {
            ReportResolution.None => "Unresolved",
            ReportResolution.NoAction => "No Action",
            ReportResolution.Warning => "Warning",
            ReportResolution.UserDisabled => "Disabled",
            ReportResolution.ContentRemoved => "Removed",
            ReportResolution.UserDeleted => "User Deleted",
            ReportResolution.Duplicate => "Duplicate",
            ReportResolution.Kicked => "Kicked",
            ReportResolution.Banned => "Banned",
            _ => "Unknown"
        };
    }

    private async Task DisableUserAndResolve()
    {
        if (!Data.Report.ReportedUserId.HasValue) return;

        _isSubmitting = true;
        StateHasChanged();

        var disableResult = await StaffService.SetUserDisabledAsync(Data.Report.ReportedUserId.Value, true,
            $"Disabled while resolving report {Data.Report.Id}");
        if (!disableResult.Success)
        {
            // Plain toast auto-dismisses; a ProgressToastData added via AddToast
            // never closes because nothing awaits its ProgressTask (#1565)
            ToastContainer.Instance.AddToast(new ToastData(
                "Error", $"Failed to disable user: {disableResult.Message}", ToastProgressState.Failure));
            _isSubmitting = false;
            StateHasChanged();
            return;
        }

        await ResolveReport(ReportResolution.UserDisabled);
    }

    private async Task ResolveReport(ReportResolution resolution)
    {
        _selectedResolution = resolution;
        await SubmitResolution();
    }

    private async Task SubmitResolution()
    {
        _isSubmitting = true;
        StateHasChanged();

        var result = await StaffService.ResolveReportAsync(Data.Report.Id, _selectedResolution, _staffNotes);

        _isSubmitting = false;

        if (!result.Success)
        {
            // Plain toast auto-dismisses; a ProgressToastData added via AddToast
            // never closes because nothing awaits its ProgressTask (#1565)
            ToastContainer.Instance.AddToast(new ToastData(
                "Error", $"Failed to resolve report: {result.Message}", ToastProgressState.Failure));
            StateHasChanged();
            return;
        }

        // Update local report state
        Data.Report.Resolution = _selectedResolution;
        Data.Report.StaffNotes = _staffNotes;
        Data.Report.ResolvedAt = DateTime.UtcNow;

        // Plain success toast auto-dismisses; a ProgressToastData added via
        // AddToast never closes because nothing awaits its ProgressTask (#1565)
        ToastContainer.Instance.AddToast(new ToastData(
            "Success", "Report resolved successfully", ToastProgressState.Success));

        if (Data.OnResolved != null)
        {
            await Data.OnResolved.Invoke();
        }

        StateHasChanged();
    }
}
