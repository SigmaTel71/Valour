@using Valour.Sdk.ModelLogic.QueryEngines
@inject ValourClient Client
@inject StaffService StaffService
@inject IStringLocalizer<StaffUserQueryTable> Localizer
@inject IStringLocalizer<ValourApp> CommonLocalizer

<LanguageTrackProvider OnInitializeEvent="provider => provider.RegisterComponent(this)" />
<QueryTable 
    @ref="@_table"
    Columns="@_columns"
    Engine="@_engine"
    ShowSearch="@true"
    SearchPlaceholder=@Localizer["Search name..."]
    Infinite="@true"
/>

@code {
    [CascadingParameter]
    public ModalRoot ModalRoot { get; set; }

    private QueryTable<User> _table;

    private List<ColumnDefinition<User>> _columns;
    
    private string _nameSearch = string.Empty;

    private StaffUserQueryEngine _engine;

    protected override void OnInitialized()
    {
        _engine = new StaffUserQueryEngine(Client.PrimaryNode);
        
        _columns = new()
        {
            new ()
            {
                Name = Localizer["Card"],
                RenderFragment = (rowData) =>
                    @<UserInfoComponent User="@rowData.Row" ShowBadges="false" ShowState="false" />
            },
            new ()
            {
                Name = Localizer["Name"],
                RenderFragment = (rowData) =>
                    @<span>@rowData.Row.NameAndTag</span>
            },
            new ()
            {
                Name = Localizer["Actions"],
                RenderFragment = (rowData) =>
                    @<div class="button-row">
                        <button class="v-btn" @onclick="@(() => OpenTools(rowData.Row))">@Localizer["Tools"]</button>

                        @if (rowData.Row.Disabled)
                        {
                            <button class="v-btn primary" @onclick="@(() => EnableUser(rowData.Row))">@Localizer["Enable"]</button>
                        }
                        else
                        {
                            <button class="v-btn secondary" @onclick="@(() => DisableUser(rowData.Row))">@Localizer["Disable"]</button>
                        }

                        <button class="v-btn danger" @onclick="@(() => DeleteUser(rowData.Row))">@Localizer["Delete"]</button>
                    </div>
            }
        };
    }

    /* Staff Controls */

    private void OpenTools(User user)
    {
        ModalRoot.OpenModal<StaffUserToolsModal>(new StaffUserToolsModal.ModalParams()
        {
            User = user
        });
    }

    public void DisableUser(User user)
    {
        ModalRoot.OpenModal<StaffReasonModalComponent>(new StaffReasonModalComponent.ModalParams()
        {
            Title = Localizer["Disable {0}?", user.NameAndTag],
            Description = Localizer["The account is disabled and every session is signed out."],
            ConfirmText = Localizer["Disable"],
            Danger = true,
            ConfirmEvent = async reason =>
            {
                var toastData = new ProgressToastData<TaskResult>()
                {
                    Title = Localizer["Disabling User"],
                    SuccessMessage = Localizer["User has been disabled"],
                    Message = CommonLocalizer["Waiting for result..."],
                    ProgressTask = StaffService.SetUserDisabledAsync(user.Id, true, reason)
                };

                var result = await ToastContainer.Instance.WaitToastWithTaskResult(toastData);

                if (result.Success)
                {
                    await _table.Requery();
                }
            }
        });
    }

    private void EnableUser(User user)
    {
        ModalRoot.OpenModal<StaffReasonModalComponent>(new StaffReasonModalComponent.ModalParams()
        {
            Title = Localizer["Enable {0}?", user.NameAndTag],
            Description = Localizer["The account is re-enabled and can log in again."],
            ConfirmText = Localizer["Enable"],
            ConfirmEvent = async reason =>
            {
                var toastData = new ProgressToastData<TaskResult>()
                {
                    Title = Localizer["Enabling User"],
                    SuccessMessage = Localizer["User has been enabled"],
                    Message = CommonLocalizer["Waiting for result..."],
                    ProgressTask = StaffService.SetUserDisabledAsync(user.Id, false, reason)
                };

                var result = await ToastContainer.Instance.WaitToastWithTaskResult(toastData);

                if (result.Success)
                {
                    await _table.Requery();
                }
            }
        });
    }

    public void DeleteUser(User user)
    {
        ModalRoot.OpenModal<StaffReasonModalComponent>(new StaffReasonModalComponent.ModalParams()
        {
            Title = Localizer["Hard Delete {0}?", user.NameAndTag],
            Description = Localizer["This CANNOT be undone. The account and its data are permanently deleted."],
            CancelText = Localizer["Cancel"],
            ConfirmText = Localizer["Delete"].ToString().ToUpperInvariant(),
            Danger = true,
            ConfirmEvent = async reason =>
            {
                var toastData = new ProgressToastData<TaskResult>()
                {
                    Title = Localizer["Deleting User"],
                    SuccessMessage = Localizer["User has been deleted"],
                    Message = CommonLocalizer["Waiting for result..."],
                    ProgressTask = StaffService.DeleteUserAsync(user.Id, reason)
                };

                var result = await ToastContainer.Instance.WaitToastWithTaskResult(toastData);

                if (result.Success)
                {
                    await _table.Requery();
                }
            }
        });
    }
}
